---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import ToasterWrapper from '../components/ui/ToasterWrapper.tsx';
import { Heart, Music as MusicIcon, User, MessageCircle, Sparkles } from 'lucide-react';

// per-page title（默认兼容现有页面）
const { title = '克罗雅的小网站' } = Astro.props;

// Canonical URL for SEO / Open Graph (requires `site` in astro.config)
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Get current year dynamically
const currentYear = new Date().getFullYear();
const startYear = 2026;

// Format year display: "2026" or "2026 - 2027"
const yearDisplay = currentYear === startYear
  ? `${startYear}`
  : `${startYear} - ${currentYear}`;

// /ai/* 页面的 studio 从不调用 toast（grep 证实 sonner 仅 SongList/DanmakuBoard 使用），
// 不挂 ToasterWrapper 岛——这 4+1 页各省 32KB sonner chunk
const isAiPage = /^\/ai(?:\/|$)/.test(Astro.url.pathname);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    {/* ClientRouter（P1-1）：站内链接改为软导航，配合 PersistentPlayer 的
        transition:persist 实现 / ↔ /music 点歌续播；预取由 prefetchAll 驱动 */}
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="description" content="克罗雅 - 从远古时期的天堂而来的恶魔&天使" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* font preload（P1-5）：与 global.css @font-face 同一 woff2，把加载提前到
        与 CSS 解析并行；crossorigin 必带——font 加载是 anonymous CORS 模式，
        不带会 preload 两次。font-display:swap 见 font-loading.test.ts */}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/noto-serif-sc-var.woff2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="克罗雅 - 从远古时期的天堂而来的恶魔&天使" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Apply theme immediately to prevent flash
      (function() {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (err) {
          // localStorage 不可用（隐私模式等）时跟随系统偏好
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = saved === 'dark' || (!saved && prefersDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Desktop Navbar (Top) -->
    <nav class="hidden md:flex fixed top-0 left-0 right-0 z-50 glass px-6 py-4 items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, oklch(0.78 0.10 15), oklch(0.72 0.08 240));">
          <Heart className="w-5 h-5 text-white" fill="currentColor" />
        </div>
        <span class="font-serif text-xl font-semibold" style="color: oklch(0.58 0.16 15);">
          Kloa
        </span>
      </div>

      <div class="flex items-center gap-8">
        <a href="/" class="nav-link">首页</a>
        <a href="/music/" class="nav-link">歌单</a>
        <a href="/danmaku/" class="nav-link">独轮车</a>
        <a href="/ai/" class="nav-link">AI 实验室</a>
        <a href="/about/" class="nav-link">关于</a>
      </div>

      <ThemeToggle />
    </nav>

    <!-- Mobile Theme Toggle (Top Right) -->
    <div class="md:hidden fixed top-4 right-4 z-50" data-testid="mobile-theme-toggle">
      <ThemeToggle />
    </div>

    <!-- Mobile Navbar (Bottom) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 glass px-4 py-3 flex items-center justify-around">
      <a href="/" class="mobile-nav-link">
        <Heart className="w-6 h-6" />
        <span class="text-xs mt-1">首页</span>
      </a>
      <a href="/music/" class="mobile-nav-link">
        <MusicIcon className="w-6 h-6" />
        <span class="text-xs mt-1">歌单</span>
      </a>
      <a href="/danmaku/" class="mobile-nav-link">
        <MessageCircle className="w-6 h-6" />
        <span class="text-xs mt-1">独轮车</span>
      </a>
      <a href="/ai/" class="mobile-nav-link">
        <Sparkles className="w-6 h-6" />
        <span class="text-xs mt-1">AI</span>
      </a>
      <a href="/about/" class="mobile-nav-link">
        <User className="w-6 h-6" />
        <span class="text-xs mt-1">关于</span>
      </a>
    </nav>

    <!-- Main Content -->
    <main class="min-h-screen pt-16 md:pt-20 pb-20 md:pb-0">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="hidden md:block py-4 text-center" style="background: var(--bg-secondary);">
      <p style="color: var(--text-secondary);">
        © {yearDisplay} Kloa Site. Made with 💖 for the fans.
      </p>
    </footer>

    <!-- Sonner Toaster（/ai/* 页不挂——无 toast 调用，省 32KB chunk） -->
    {!isAiPage && <ToasterWrapper client:idle />}

    <!-- Theme toggle（vanilla）：事件委托同时服务桌面 nav 与移动端两个按钮，
         替代原先每页 2 个 client:load React 岛。初始渲染由 head 内 FOUC 脚本负责。 -->
    <script is:inline>
      (function () {
        // 防重复绑定（幂等）：脚本全站仅此一份，但避免意外双执行
        if (window.__themeToggleInit) return;
        window.__themeToggleInit = true;

        var TO_DARK = '切换到恶魔模式';
        var TO_LIGHT = '切换到天使模式';

        function syncLabels() {
          var label = document.documentElement.classList.contains('dark') ? TO_LIGHT : TO_DARK;
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-label', label);
          });
        }

        document.addEventListener('click', function (e) {
          var btn = e.target instanceof Element ? e.target.closest('[data-theme-toggle]') : null;
          if (!btn) return;
          var toDark = !document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', toDark);
          try {
            localStorage.setItem('theme', toDark ? 'dark' : 'light');
          } catch (err) {
            // localStorage 不可用（隐私模式等）时静默降级，视觉切换不受影响
          }
          syncLabels();
        });

        // SSR 恒天使态；真实主题已由 head FOUC 脚本落到 html.dark，这里只同步按钮文案
        syncLabels();

        // localStorage 读取守卫：隐私模式等场景抛异常时视作无保存偏好，跟随系统
        function readSavedTheme() {
          try {
            return localStorage.getItem('theme');
          } catch (err) {
            return null;
          }
        }

        // 按 localStorage/系统偏好重落 dark 类并同步按钮文案（after-swap 与跨标签页共用）
        function applyTheme() {
          var saved = readSavedTheme();
          var isDark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', isDark);
          syncLabels();
        }

        // 无显式偏好时跟随系统（对齐旧 React 版行为；有 saved 值则不动）
        var mql = window.matchMedia('(prefers-color-scheme: dark)');
        mql.addEventListener('change', function () {
          if (readSavedTheme()) return;
          document.documentElement.classList.toggle('dark', mql.matches);
          syncLabels();
        });

        // 跨标签页同步：另一标签页改主题/clear 时本页跟随（对齐旧 React 版行为）
        window.addEventListener('storage', function (e) {
          if (e.key !== 'theme' && e.key !== null) return;
          applyTheme();
        });

        // ClientRouter 软导航后的主题重同步：swap 会用新文档的 <html> 属性覆盖当前
        // （SSR 恒天使态 → dark 类被剥掉），且本脚本与 head FOUC 脚本因内容相同不会
        // 重新执行（ClientRouter 按 textContent 去重）。document/window 级监听器存活，
        // 每个软导航后按 localStorage/系统偏好重落 dark 类并同步按钮文案。
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>

    <style is:global>
      /* Desktop Nav Links */
      .nav-link {
        position: relative;
        font-family: var(--font-sans);
        font-weight: 500;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.3s ease;
      }

      .nav-link:hover {
        color: var(--accent-primary);
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
        transition: width 0.3s ease;
      }

      .nav-link:hover::after {
        width: 100%;
      }

      /* Mobile Nav Links */
      .mobile-nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: var(--text-secondary);
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .mobile-nav-link:hover {
        color: var(--accent-primary);
        transform: translateY(-2px);
      }

      /* Theme-aware glow for active states */
      :root .nav-link:hover,
      :root .mobile-nav-link:hover {
        text-shadow: 0 0 10px var(--color-glow-angel);
      }

      :root.dark .nav-link:hover,
      :root.dark .mobile-nav-link:hover {
        text-shadow: 0 0 10px var(--color-glow-demon);
      }
    </style>
  </body>
</html>
