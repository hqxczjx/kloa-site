---
// 独轮车弹幕板（P2-4 静态化，取代 src/components/react/DanmakuBoard.tsx + 其内嵌
// ContributeDialog）：卡片/筛选按钮 SSR 直出（数据源 src/data/danmaku.ts 不变），
// DOM/类名与旧 React 版 SSR 输出逐类对齐，Tailwind 与既有 CSS 选择器不受影响。
// 交互（筛选切换 / 点击复制 + 自研 toast）由末尾 is:inline 内联脚本以事件委托实现
// （?raw 引入同源文件，单测直接跑它）——本页 React 岛归零。
// 筛选是瞬时 UI 状态（旧版 useState，无 localStorage/URL 持久化），vanilla 版同样不持久化。
import { danmaku, type DanmakuCategory } from '../../data/danmaku';
import ContributeDialog from './ContributeDialog.astro';
import boardScript from '../../scripts/danmaku-board.js?raw';

const LIMIT = 40;

type Filter = 'all' | DanmakuCategory;

const cardTheme: Record<DanmakuCategory, { badge: string; border: string }> = {
  cheer: {
    badge: 'bg-pink-100 text-pink-700 dark:bg-pink-900/40 dark:text-pink-200',
    border: 'border-pink-200 dark:border-pink-500/30',
  },
  meme: {
    badge: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-200',
    border: 'border-blue-200 dark:border-blue-500/30',
  },
  memorial: {
    badge: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-200',
    border: 'border-purple-200 dark:border-purple-500/30',
  },
};

const categoryLabel: Record<DanmakuCategory, string> = {
  cheer: '应援',
  meme: '整活',
  memorial: '纪念',
};

// lucide 图标（与旧 React 版 SSR 输出逐属性一致）
const filterIcon: Record<Filter, string> = {
  all: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-4 h-4" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>',
  cheer: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart w-4 h-4" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path></svg>',
  meme: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ghost w-4 h-4" aria-hidden="true"><path d="M9 10h.01"></path><path d="M15 10h.01"></path><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"></path></svg>',
  memorial: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cake w-4 h-4" aria-hidden="true"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"></path><path d="M2 21h20"></path><path d="M7 8v3"></path><path d="M12 8v3"></path><path d="M17 8v3"></path><path d="M7 4h.01"></path><path d="M12 4h.01"></path><path d="M17 4h.01"></path></svg>',
};

// lucide copy（空态图标；与旧 React 版 className 逐类一致）
const copyIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy w-16 h-16 mx-auto mb-4" aria-hidden="true" style="color: var(--text-secondary)"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';

const filters: { value: Filter; label: string }[] = [
  { value: 'all', label: '全部' },
  { value: 'cheer', label: '应援' },
  { value: 'meme', label: '整活' },
  { value: 'memorial', label: '纪念' },
];

const ACTIVE_FILTER_CLASSES = 'bg-gradient-to-r from-pink-500 to-blue-500 text-white shadow-lg';
---

<div class="w-full max-w-5xl mx-auto px-4 py-8 pb-32" data-danmaku-board>
  <h1 class="text-3xl font-serif font-bold text-center mb-8" style="color: var(--text-primary)">
    独轮车弹幕复制
  </h1>

  <div class="glass rounded-2xl p-6 mb-8">
    <div class="flex flex-wrap gap-3 justify-center mb-6">
      {filters.map(({ value, label }) => (
        <button
          data-filter={value}
          aria-label={label}
          class={`flex items-center gap-2 px-5 py-2.5 rounded-full font-medium transition-all duration-300 ${value === 'all' ? ACTIVE_FILTER_CLASSES : ''}`}
          style={value !== 'all' ? 'background: var(--bg-secondary); color: var(--text-secondary)' : undefined}
        >
          <Fragment set:html={filterIcon[value]} />
          {label}
        </button>
      ))}
    </div>

    <div class="flex flex-wrap justify-center gap-4">
      <ContributeDialog />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {danmaku.map((d) => {
      const over = d.text.length > LIMIT;
      return (
        <button
          data-danmaku-card
          data-category={d.category}
          data-danmaku-text={d.text}
          aria-label={`复制 ${d.text}`}
          class={`glass border-2 ${cardTheme[d.category].border} rounded-2xl p-5 text-left transition-all duration-200 hover:scale-[1.02] active:scale-95 flex flex-col gap-2`}
        >
          <span class={`self-start text-xs px-2 py-0.5 rounded-full ${cardTheme[d.category].badge}`}>
            {categoryLabel[d.category]}
          </span>
          <span class="text-base break-all" style="color: var(--text-primary)">{d.text}</span>
          {d.note && (
            <span class="text-xs" style="color: var(--text-secondary)">{d.note}</span>
          )}
          <span class="flex items-center justify-between">
            <span class="text-xs" style="color: var(--text-secondary)">点击复制</span>
            <span
              class={`text-xs font-semibold ${over ? 'text-red-500' : ''}`}
              style={!over ? 'color: var(--text-secondary)' : undefined}
              data-over-limit={over ? 'true' : 'false'}
            >
              {d.text.length}/{LIMIT}
            </span>
          </span>
        </button>
      );
    })}
  </div>

  <!-- 空分类占位：与旧 React 版「filtered.length === 0」渲染等价，由脚本按可见数切换 -->
  <div class="text-center py-16" data-danmaku-empty style="display: none">
    <Fragment set:html={copyIcon} />
    <p class="text-lg" style="color: var(--text-secondary)">该分类暂无文案</p>
  </div>
</div>

<script is:inline set:html={boardScript} />
