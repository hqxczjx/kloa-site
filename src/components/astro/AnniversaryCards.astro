---
// 纪念日卡片（P2-2 静态化，取代 src/components/react/AnniversaryCards.tsx + AnniversaryCard.tsx）：
// - 两卡无实时逻辑：日期/标签构建期定死直接 SSR；「距离 N 天」依赖「今天」，
//   由末尾 is:inline 内联脚本写入 data-anniv-days 节点（?raw 引入同源文件，单测直接跑它）。
// - DOM 结构/类名与旧 React 版逐类对齐（glass 卡、hidden md:block md:fixed 定位、
//   animate-fade-up、lucide 图标原 SVG），CSS 选择器与视觉不变。
// - 卡片上显示的日期里的年份仅是展示文本：倒计时按「今年已过翻明年」自动滚动，
//   跨年无需重新生成本组件（见 anniversary-countdown.js 的 rollover 逻辑）。
// - 脚本标签必须带 data-astro-rerun：ClientRouter 按 textContent 去重内联脚本且
//   默认不重执行（router 初始化即把首屏脚本记入已执行集合，软导航 swap 时跳过），
//   离开首页再返回时新 SSR DOM 的「—」占位将无人回填；rerun 让每次 swap 重新执行
//   （脚本纯重算幂等，重复执行无副作用）。
import countdownScript from '../../scripts/anniversary-countdown.js?raw';

const cards = [
  {
    date: '2026-07-19',
    label: '生日',
    className: 'hidden md:block md:fixed md:bottom-24 md:right-6 md:w-48 md:z-20',
    // lucide cake（与旧 React 版 SSR 输出逐属性一致）
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cake w-5 h-5 text-pink-500 dark:text-blue-500" aria-hidden="true"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"></path><path d="M2 21h20"></path><path d="M7 8v3"></path><path d="M12 8v3"></path><path d="M17 8v3"></path><path d="M7 4h.01"></path><path d="M12 4h.01"></path><path d="M17 4h.01"></path></svg>',
  },
  {
    date: '2026-01-16',
    label: '出道日',
    className: 'hidden md:block md:fixed md:bottom-64 md:right-6 md:w-48 md:z-20',
    // lucide sparkles（与旧 React 版 SSR 输出逐属性一致）
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-5 h-5 text-pink-500 dark:text-blue-500" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>',
  },
];
---

{
  cards.map(({ date, label, className, icon }) => (
    <div
      class={`fixed glass rounded-2xl p-4 backdrop-blur-md bg-white/10 dark:bg-slate-900/10 border border-white/20 dark:border-white/5 shadow-lg hover:scale-105 transition-transform duration-300 animate-fade-up ${className}`}
    >
      <div class="flex items-center gap-2 mb-2">
        <Fragment set:html={icon} />
        <span class="text-sm" style="color: var(--text-secondary);">{label}</span>
      </div>

      <div class="mb-2">
        <div class="text-2xl font-bold font-serif" style="color: var(--text-primary);">{date}</div>
      </div>

      <div>
        <div class="text-xs opacity-75">距离{label}纪念日</div>
        <div class="text-2xl font-bold font-serif" style="color: var(--text-primary);" data-anniv-days={date}>—</div>
      </div>
    </div>
  ))
}

<script is:inline set:html={countdownScript} data-astro-rerun />
