# ⚠️ 本文件在 run_worker_first: true 下不生效——Cloudflare 对 Worker 返回的
# 响应不应用 _headers 自定义头（实测：HTML 无 CDN-Cache-Control、/_astro/*
# 拼出双值 cache-control）。唯一真源是 worker/index.ts 的 withResponseHeaders()；
# 本文件仅作策略文档留存，改缓存规则需两处同步。

# Fingerprinted build assets — safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.svg
  Cache-Control: public, max-age=604800

# Sitemap & robots
/sitemap*.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# HTML pages — browser always revalidates (304, no heuristic caching);
# edge serves stale-while-revalidate: 部署频率低，重复访问零 RTT，最多 10 分钟陈旧
/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=600, stale-while-revalidate=86400
