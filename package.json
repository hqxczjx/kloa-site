{
  "name": "kloa-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:wrangler": "wrangler dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun test-e2e.ts",
    "test:e2e:ui": "bun test-e2e.ts --ui",
    "test:e2e:debug": "bun test-e2e.ts --debug",
    "test:e2e:headed": "bun test-e2e.ts --headed",
    "test:e2e:raw": "playwright test",
    "test:all": "bun run test:run && bun run test:e2e",
    "type-check": "tsc --noEmit",
    "astro-check": "astro check",
    "gen:fonts": "node scripts/generate-font-subset.mjs",
    "setup:e2e": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "happy-dom": "^20.11.2",
    "jsdom": "30.0.1",
    "subset-font": "^2.5.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@nanostores/react": "^1.1.0",
    "astro": "^7.2.0",
    "lucide-react": "^1.31.0",
    "nanostores": "^1.4.2",
    "pinyin-pro": "^3.28.2",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  }
}
