{
  "name": "kloa-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-song-data.mjs && astro dev",
    "dev:wrangler": "wrangler dev",
    "start": "node scripts/generate-song-data.mjs && astro dev",
    "build": "node scripts/generate-song-data.mjs && astro check && astro build",
    "preview": "astro preview",
    "test": "node scripts/generate-song-data.mjs && vitest run && node scripts/check-font-coverage.mjs",
    "test:ui": "node scripts/generate-song-data.mjs && vitest --ui",
    "test:run": "node scripts/generate-song-data.mjs && vitest run",
    "test:watch": "node scripts/generate-song-data.mjs && vitest",
    "test:coverage": "node scripts/generate-song-data.mjs && vitest run --coverage",
    "test:e2e": "bun test-e2e.ts",
    "test:e2e:ui": "bun test-e2e.ts --ui",
    "test:e2e:debug": "bun test-e2e.ts --debug",
    "test:e2e:headed": "bun test-e2e.ts --headed",
    "test:e2e:raw": "playwright test",
    "test:all": "bun run test:run && bun run test:e2e",
    "type-check": "node scripts/generate-song-data.mjs && tsc --noEmit",
    "astro-check": "node scripts/generate-song-data.mjs && astro check",
    "lint:security": "oxlint -c .oxlintrc.json",
    "lint:secrets": "gitleaks detect --source . --no-banner --redact --verbose",
    "gen:fonts": "node scripts/generate-font-subset.mjs",
    "gen:crops": "node scripts/generate-character-crops.mjs",
    "setup:e2e": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.78.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "lucide-react": "^1.31.0",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  }
}
